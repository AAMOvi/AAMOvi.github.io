---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchItem from '../components/ResearchItem.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { profile } from '../data/profile';
import { completedResearch, ongoingResearch, revisionResearch } from '../data/research';
import { publications } from '../data/publications';

const description = 'Abdullah Al Maruf is a CSE undergraduate at RUET studying visual grounding in vision-language models, multimodal evaluation and robustness, efficient visual representations, and knowledge distillation.';
---
<BaseLayout title="Abdullah Al Maruf — Computer Vision and Multimodal Research" description={description}>
  <section class="hero shell">
    <div class="hero-kicker">
      <span>CSE undergraduate</span>
      <span>RUET · Bangladesh</span>
    </div>
    <div class="hero-grid">
      <figure class="hero-portrait">
        <img src="/abdullah-al-maruf.webp" alt="Portrait of Abdullah Al Maruf" width="800" height="800" fetchpriority="high" decoding="async" />
        <figcaption>
          <h1>{profile.name}</h1>
          <p class="portrait-role">{profile.title} · {profile.institutionShort}</p>
        </figcaption>
      </figure>
      <div class="hero-statement">
        <p class="identity">{profile.researchIdentity}</p>
        <p>{profile.summary}</p>
        <div class="hero-actions">
          <a class="button primary" href="/Abdullah_Al_Maruf_CV.pdf">Download CV</a>
          <a class="button" href={`mailto:${profile.email}`}>Email</a>
          <a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
          <a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <SectionHeading index="01" title="Selected research" />
    <div class="item-list">{completedResearch.map((project, index) => <ResearchItem project={project} index={index} compact />)}</div>
  </section>

  <section class="section shell">
    <SectionHeading index="02" title="Publications" />
    <div class="publication-list">{publications.map((publication, index) => <PublicationItem publication={publication} index={index} />)}</div>
    <a class="section-link" href="/publications/">Publication details</a>
  </section>

  <section class="section shell">
    <SectionHeading index="03" title="Current research" />
    <div class="item-list">{[...ongoingResearch, ...revisionResearch].map((project, index) => <ResearchItem project={project} index={index} compact />)}</div>
    <a class="section-link" href="/research/">Research overview</a>
  </section>

  <section class="section shell preparation-section">
    <SectionHeading index="04" title="Background" />
    <div class="preparation-grid">
      <div>
        <h3>{profile.degree}</h3>
        <p>{profile.institution}</p>
        <p class="meta-copy">Expected {profile.graduation} · CGPA {profile.cgpa}</p>
      </div>
      <div>
        <h3>Methods and tools</h3>
        <p>{profile.skills.research.join(' · ')}</p>
        <p class="meta-copy">{profile.skills.technical.join(' · ')}</p>
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="shell contact-grid">
      <p class="eyebrow">05 · Contact</p>
      <h2>Research conversations and collaboration.</h2>
      <a class="button inverted" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </section>
</BaseLayout>
