---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchItem from '../components/ResearchItem.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { profile } from '../data/profile';
import { research } from '../data/research';
import { publications } from '../data/publications';

const description = 'Abdullah Al Maruf is an undergraduate researcher working on vision-language models, multimodal reasoning, cross-lingual multimodal learning, robustness, and efficient learning.';
---
<BaseLayout title="Abdullah Al Maruf — Multimodal Vision Research" description={description}>
  <section class="hero shell">
    <div class="hero-kicker">
      <span>Undergraduate Researcher</span>
      <span>RUET · Bangladesh</span>
    </div>
    <div class="hero-grid">
      <div>
        <h1>{profile.name}</h1>
        <p class="affiliation">{profile.department}<br />{profile.institution}</p>
      </div>
      <div class="hero-statement">
        <p class="identity">{profile.researchIdentity}</p>
        <p>{profile.summary}</p>
        <div class="hero-actions">
          <a class="button primary" href="/Abdullah_Al_Maruf_CV.pdf">CV <span aria-hidden="true">↓</span></a>
          <a class="button" href={`mailto:${profile.email}`}>Email</a>
          <a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <SectionHeading index="01" title="Research highlights" intro="Current work and recent scholarly activity." />
    <div class="item-list">{research.map((project, index) => <ResearchItem project={project} index={index} compact />)}</div>
    <a class="section-link" href="/research/">View research in detail <span aria-hidden="true">→</span></a>
  </section>

  <section class="section shell themes-section">
    <SectionHeading index="02" title="Research themes" />
    <ul class="theme-grid">{profile.interests.map((interest, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{interest}</li>)}</ul>
  </section>

  <section class="section shell">
    <SectionHeading index="03" title="Selected publications" intro="Accepted and under-review work. Links are shown only when a public source is available." />
    <div class="publication-list">{publications.slice(0, 3).map((publication, index) => <PublicationItem publication={publication} index={index} />)}</div>
    <a class="section-link" href="/publications/">All publications <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-band">
    <div class="shell contact-grid">
      <p class="eyebrow">04 · Contact</p>
      <h2>Research conversations and collaboration.</h2>
      <a class="button inverted" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </section>
</BaseLayout>
