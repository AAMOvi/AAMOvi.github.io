---
import type { ResearchProject } from '../data/research';
interface Props { project: ResearchProject; index: number; compact?: boolean; }
const { project, index, compact = false } = Astro.props;
---
<article class:list={['research-item', { compact }]}>
  <p class="item-index">{String(index + 1).padStart(2, '0')}</p>
  <div>
    <div class="research-meta">
      <span>{project.status}</span>
      <span>{project.context}</span>
    </div>
    <h3>{project.detailPath ? <a href={project.detailPath}>{project.shortTitle}</a> : project.shortTitle}</h3>
    {!compact && <p class="full-title">{project.title}</p>}
    <p class="research-question"><span>Question</span>{project.question}</p>
    <p>{compact && project.finding ? project.finding : project.summary}</p>
    {project.contribution && <p class="contribution"><span>Contribution</span>{project.contribution}</p>}
    {project.supervisor && <p class="supervisor"><span>Supervised by</span> {project.supervisor[0]}<br />{project.supervisor[1]}</p>}
    {!compact && <ul class="tag-list" aria-label="Research themes">{project.themes.map((theme) => <li>{theme}</li>)}</ul>}
    <div class="item-actions">
      {project.detailPath && <a href={project.detailPath}>Project details</a>}
      {project.links?.map((link) => <a href={link.url} target="_blank" rel="noreferrer" aria-label={`${link.label} for ${project.shortTitle} (opens in a new tab)`}>{link.label}</a>)}
    </div>
  </div>
</article>
