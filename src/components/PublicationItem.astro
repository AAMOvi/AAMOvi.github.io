---
import type { Publication } from '../data/publications';
interface Props { publication: Publication; index: number; }
const { publication, index } = Astro.props;
---
<article class="publication-item">
  <p class="item-index">{String(index + 1).padStart(2, '0')}</p>
  <div>
    <div class="publication-meta"><span>{publication.year}</span><span>{publication.status}</span></div>
    <h3>{publication.title}</h3>
    <p class="authors">{publication.authors.map((author, authorIndex) => <>{author === 'Abdullah Al Maruf' ? <strong>{author}</strong> : author}{authorIndex < publication.authors.length - 1 ? ', ' : ''}</>)}</p>
    <p class="venue">{publication.venue}</p>
    <p class="contribution-type">{publication.contributionType}</p>
    {publication.links && <div class="item-actions">{publication.links.map((link) => <a href={link.url} target="_blank" rel="noreferrer" aria-label={`${link.label} for ${publication.title} (opens in a new tab)`}>{link.label}</a>)}</div>}
  </div>
</article>
